<Window Title="Freeway Player" Width="1180" Height="780">
    <VBox Spacing="0" Slot.Padding="20">
        <HBox Spacing="12">
            <Image Name="app-logo" Width="32" Height="32" Slot.VAlign="Center"/>
            <VBox Spacing="1" Slot.VAlign="Center">
                <Label Text="FREEWAY PLAYER" TextSize="17"/>
                <Label Text="Tu música, en orden" TextSize="11" Color.Text="#8F8999"/>
            </VBox>
            <Spacer Width="20"/>
            <Label Text="LISTAS" TextSize="10" Color.Text="#8F8999" Slot.VAlign="Center"/>
            <TabView Name="playlist-tabs" Documents="true" Height="42" Slot.Fill="1" OnChanged="player.playlist_changed"/>
            <TextInput Name="playlist-name" Width="160" Placeholder="Renombrar lista" Tooltip="Escribe un nombre y pulsa Enter" OnCommitted="player.rename_playlist"/>
            <Button Text="+" Style="Flat" Tooltip="Crear lista" OnClicked="player.add_playlist"/>
        </HBox>

        <Separator Slot.Padding="0,12,0,14"/>

        <Splitter Orientation="Horizontal" MinPaneSize="360" Slot.Fill="1">
            <VBox Spacing="10" Slot.Fill="2" Slot.Padding="0,4,18,10">
                <HBox Spacing="10">
                    <VBox Spacing="2" Slot.Fill="1">
                        <Label Text="Biblioteca" TextSize="21"/>
                        <Label Name="playlist-summary" Text="Lista vacía" TextSize="12" Color.Text="#8F8999"/>
                    </VBox>
                    <Button Text="+ Añadir pistas" Style="Primary" Tooltip="Añadir archivos de audio a esta lista" OnClicked="player.open" Slot.VAlign="Center"/>
                    <Button Text="-" Style="Flat" Tooltip="Quitar la pista seleccionada de esta lista" OnClicked="player.remove_track" Slot.VAlign="Center"/>
                </HBox>

                <ListView Name="track-list" Color.Panel="#131118" OnActivated="player.play_selected" Slot.Fill="1"/>
            </VBox>

            <Switcher Name="right-panel" Slot.Fill="1">
                <VBox Spacing="14" Slot.Padding="10,4,0,10">
                    <HBox Spacing="10">
                        <VBox Spacing="2">
                            <Label Text="Carátula" TextSize="18"/>
                            <Label Text="Imagen de la pista actual" TextSize="11" Color.Text="#8F8999"/>
                        </VBox>
                    </HBox>
                    <Switcher Name="cover-switcher" Slot.Fill="1">
                        <VBox Spacing="12" Slot.HAlign="Center" Slot.VAlign="Center">
                            <Spacer Slot.Fill="1"/>
                            <Label Text="♫" TextSize="88" Color.Text="#B9A3F5" TextAlign="Center"/>
                            <Label Text="FREEWAY PLAYER" TextSize="13" Color.Text="#8F8999" TextAlign="Center"/>
                            <Label Text="Sin carátula" TextSize="11" Color.Text="#716B79" TextAlign="Center"/>
                            <Spacer Slot.Fill="1"/>
                        </VBox>
                        <Image Name="cover-image" Slot.Fill="1" CornerRadius="10"/>
                    </Switcher>
                </VBox>

                <VBox Spacing="10" Slot.Padding="10,4,0,10">
                    <HBox Spacing="10">
                        <Button Text="←" Style="Flat" Tooltip="Volver a la carátula" OnClicked="player.close_metadata"/>
                        <VBox Spacing="2">
                            <Label Text="Metadatos" TextSize="18"/>
                            <Label Text="Edita las etiquetas y la carátula" TextSize="11" Color.Text="#8F8999"/>
                        </VBox>
                    </HBox>
                    <Separator Slot.Padding="0,2,0,4"/>
                    <VBox Spacing="5">
                        <Label Text="TÍTULO" TextSize="10" Color.Text="#8F8999"/>
                        <TextInput Name="meta-title" Placeholder="Título de la pista"/>
                    </VBox>
                    <VBox Spacing="5">
                        <Label Text="ARTISTA" TextSize="10" Color.Text="#8F8999"/>
                        <TextInput Name="meta-artist" Placeholder="Artista"/>
                    </VBox>
                    <VBox Spacing="5">
                        <Label Text="ÁLBUM" TextSize="10" Color.Text="#8F8999"/>
                        <TextInput Name="meta-album" Placeholder="Álbum"/>
                    </VBox>
                    <HBox Spacing="10">
                        <VBox Spacing="5" Slot.Fill="1">
                            <Label Text="GÉNERO" TextSize="10" Color.Text="#8F8999"/>
                            <TextInput Name="meta-genre" Placeholder="Género"/>
                        </VBox>
                        <VBox Spacing="5" Width="84">
                            <Label Text="PISTA Nº" TextSize="10" Color.Text="#8F8999"/>
                            <TextInput Name="meta-track" Placeholder="—"/>
                        </VBox>
                    </HBox>
                    <VBox Spacing="5">
                        <Label Text="CARÁTULA" TextSize="10" Color.Text="#8F8999"/>
                        <HBox Spacing="8">
                            <Button Text="Elegir imagen…" Style="Flat" OnClicked="player.choose_cover"/>
                            <Button Text="Quitar" Style="Flat" Tooltip="Quitar la carátula incrustada" OnClicked="player.remove_cover"/>
                        </HBox>
                        <Label Name="cover-status" Text="Este archivo no tiene carátula" TextSize="10" Color.Text="#8F8999" Wrap="true"/>
                    </VBox>
                    <Spacer Slot.Fill="1"/>
                    <Button Text="✓  Guardar cambios" Style="Primary" OnClicked="player.save_metadata"/>
                    <Label Name="metadata-hint" Text="Selecciona una pista para editar sus etiquetas" TextSize="11" Color.Text="#8F8999" Wrap="true"/>
                </VBox>
            </Switcher>
        </Splitter>

        <Separator Slot.Padding="0,10,0,12"/>

        <VBox Spacing="8">
            <HBox Spacing="12">
                <Label Text="♫" TextSize="22" Color.Text="#B9A3F5" Slot.VAlign="Center"/>
                <VBox Spacing="2" Slot.Fill="1">
                    <Label Name="now-playing-title" Text="Ninguna pista" TextSize="15"/>
                    <Label Name="now-playing-artist" Text="Abre una lista para empezar" TextSize="11" Color.Text="#8F8999"/>
                </VBox>
                <Label Name="player-status" Text="Listo" TextSize="11" Color.Text="#8F8999" Slot.VAlign="Center"/>
            </HBox>

            <HBox Spacing="10">
                <Label Name="elapsed" Text="00:00" Width="44" TextSize="10" Color.Text="#8F8999" Slot.VAlign="Center"/>
                <Slider Name="seek" Min="0" Max="1" Value="0" Slot.Fill="1" OnChanged="player.seek"/>
                <Label Name="total" Text="--:--" Width="44" TextSize="10" Color.Text="#8F8999" TextAlign="Right" Slot.VAlign="Center"/>
            </HBox>

            <HBox Spacing="8">
                <Spacer Slot.Fill="1"/>
                <Button Name="shuffle" Style="Flat" Tooltip="Activar reproducción aleatoria para esta lista" OnClicked="player.shuffle">
                    <Image Name="shuffle-icon" Width="18" Height="18" TintText="true"/>
                </Button>
                <Button Text="⏮" Style="Flat" Tooltip="Pista anterior" OnClicked="player.previous"/>
                <Button Text="▶" Style="Primary" Tooltip="Reproducir" OnClicked="player.play"/>
                <Button Text="⏸" Style="Flat" Tooltip="Pausar" OnClicked="player.pause"/>
                <Button Text="■" Style="Flat" Tooltip="Detener" OnClicked="player.stop"/>
                <Button Text="⏭" Style="Flat" Tooltip="Pista siguiente" OnClicked="player.next"/>
                <Button Name="repeat" Style="Flat" Tooltip="Repetir esta lista al terminar" OnClicked="player.repeat">
                    <Image Name="repeat-icon" Width="18" Height="18" TintText="true"/>
                </Button>
                <Spacer Slot.Fill="1"/>
                <Label Text="◖" Tooltip="Volumen" Slot.VAlign="Center"/>
                <Slider Name="volume" Min="0" Max="1" Value="0.8" Step="0.01" Width="130" OnChanged="player.volume" Slot.VAlign="Center"/>
                <Label Name="volume-value" Text="80%" Width="38" TextAlign="Right" TextSize="11" Color.Text="#8F8999" Slot.VAlign="Center"/>
            </HBox>
        </VBox>
    </VBox>
</Window>
