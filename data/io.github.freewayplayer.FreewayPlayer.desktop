[Desktop Entry]
Name=Freeway Player
Comment=Reproductor de música local
Exec=freeway-player %U
Icon=io.github.freewayplayer.FreewayPlayer
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/wave;audio/ogg;audio/vorbis;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/x-m4a;
StartupNotify=true
